    if players_answer== val :#check if the answer of the player is right
        print()
        print("Good job ! You found the result.")
        return True
    else:
        print()
        print("Sorry but you didn't find the result.")
        return False

#linear equation

def solve_linear_equation():
    a = random.randint(1, 10)
    b = random.randint(1, 10)
    return a,b,round(-b/a,1) #we keep the solution with one decimal number

