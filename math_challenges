import random

###prime numbers challenges
def is_prime(n):#take as parameter a number
    #return true if the number is prime
    if n <= 1:
        return False
    for i in range(2,int(n**0.5)+1): # we check before the square root
        if n%i==0 : # if n is divisible by i then it is not prime.
            return False
    return True # if no divisor is found then it is a prime number.

def nearest_prime(n):
    #return the nearest prime from n (egal or above)
    while not is_prime(n): #  We check that the number is not prime.
        n+=1 # We iterate.
    return n # It escapes the loop when we have found the closest number to n that is prime.


def math_challenge_prime():

    #return true if the player has the good answer.
    print("Welcome to the prime challenge!")
    n=random.randint(10,20) # generate a random number between 10 nad 20.

    players_answer=int(input("find the prime number closer (egal or above) to {} : ".format(n)))

    correct_answer=nearest_prime(n)

    if correct_answer==players_answer: #check if the input of the player is right.
        print("Good job ! You found the prime number closer to {}".format(n))
        print()
        return True
    else:
        print("Sorry but you didn't find the prime number closer to {}".format(n))
        print()
        print("The correct answer is: {}".format(correct_answer))
        return False

